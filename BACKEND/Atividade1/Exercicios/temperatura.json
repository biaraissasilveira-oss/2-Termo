const fs = require("fs");

try {
    const dados = fs.readFileSync("./temperaturas.json", "utf-8");

    const temperaturas = JSON.parse(dados);

    for (const leitura of temperaturas) {

        if (leitura.temperatura > 350) {
            throw new Error(
                `Temperatura de ${leitura.temperatura}°C excedeu o limite permitido.`
            );
        }

        console.log(`Leitura: ${leitura.temperatura}°C - NORMAL`);
    }

} catch (erro) {
    console.log("ALARME:");
    console.log(erro.message);
}